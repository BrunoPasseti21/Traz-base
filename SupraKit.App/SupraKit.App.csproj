<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SupraKit.App</RootNamespace>
    <AssemblyName>SupraKit</AssemblyName>
    <Version>1.0.2</Version>
    <!-- Incrementar a tag quando for preciso regerar a MESMA versão (ex.: r2, r3).
         O app compara essa tag com o campo "tag" de version.json e oferece a atualização
         mesmo quando o número da versão não mudou. -->
    <UpdateTag>r2</UpdateTag>
    <ApplicationIcon>..\Imagens\icone\icone_supra.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SupraKit.Tests" />
    <AssemblyMetadata Include="UpdateTag" Value="$(UpdateTag)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Imagens\*.svg" Link="Imagens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Imagens\*.gif" Link="Imagens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Imagens\*.png" Link="Imagens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Imagens\icone\*.ico" Link="Imagens\icone\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
